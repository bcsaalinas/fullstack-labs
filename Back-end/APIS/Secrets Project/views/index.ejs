<!DOCTYPE html>
<html>

<head>
  <title>Lisper</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600&family=Playfair+Display:wght@500;700&family=Space+Grotesk:wght@400;600&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" type="text/css" href="styles/main.css">

</head>

<body>
  <main class="layout">
    <section class="hero">
      <div class="eyebrow">Lisper Archive</div>
      <h1>What's your secret?</h1>
      <p class="lede">
        A quiet place for shared truths. Hover to unveil the whisper.
      </p>
      <div class="user">
        <span class="label">From</span>
        <span class="name"><%= user %></span>
      </div>
    </section>
    <section class="stage">
      <div class="orb">
        <div class="card">
          <p>
            <%= secret %>
          </p>
        </div>
        <div class="ring ring-one"></div>
        <div class="ring ring-two"></div>
      </div>
    </section>
  </main>
</body>

</html>
