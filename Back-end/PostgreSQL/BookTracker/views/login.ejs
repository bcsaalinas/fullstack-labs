<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — BookTracker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Lora:ital,wght@0,400;0,500;1,400&family=DM+Sans:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles.css" />
  </head>

  <body class="login-page">
    <div class="page-noise"></div>

    <!-- Minimal nav -->
    <nav class="site-nav">
      <div class="nav-inner">
        <a href="/" class="site-logo">
          <span class="logo-icon">&#9753;</span>
          <span class="logo-text">BookTracker</span>
        </a>
      </div>
    </nav>

    <main class="login-main">

      <!-- Decorative ghost books left -->
      <div class="login-deco login-deco-left" aria-hidden="true">
        <div class="deco-book" style="--b-hue:28;  --b-h:110px; --b-w:36px; --b-delay:0ms;"></div>
        <div class="deco-book" style="--b-hue:180; --b-h:140px; --b-w:30px; --b-delay:80ms;"></div>
        <div class="deco-book" style="--b-hue:340; --b-h:96px;  --b-w:38px; --b-delay:160ms;"></div>
        <div class="deco-book" style="--b-hue:55;  --b-h:124px; --b-w:34px; --b-delay:240ms;"></div>
        <div class="deco-book" style="--b-hue:210; --b-h:88px;  --b-w:32px; --b-delay:320ms;"></div>
      </div>

      <!-- Auth card -->
      <div class="login-card">
        <div class="login-card-header">
          <p class="login-eyebrow">Welcome back</p>
          <h1 class="login-title">Your reading life,<br /><em>beautifully tracked.</em></h1>
          <p class="login-subtitle">Sign in to continue to your personal bookshelf.</p>
        </div>

        <div class="login-divider-deco">
          <span class="deco-line-sm"></span>
          <span class="deco-ornament-sm">&#10022;</span>
          <span class="deco-line-sm"></span>
        </div>

        <% if (locals.error) { %>
          <div class="login-error" role="alert">
            <span class="login-error-icon">&#9888;</span>
            <%= error %>
          </div>
        <% } %>

        <!-- Google Sign-In -->
        <a href="/auth/google" class="btn-google-signin btn-google-signin--large">
          <svg class="google-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          <span>Continue with Google</span>
        </a>

        <p class="login-terms">
          By signing in you agree to keep your shelf wonderfully organised.
          <br />No data is shared with third parties.
        </p>
      </div>

      <!-- Decorative ghost books right -->
      <div class="login-deco login-deco-right" aria-hidden="true">
        <div class="deco-book" style="--b-hue:270; --b-h:130px; --b-w:32px; --b-delay:40ms;"></div>
        <div class="deco-book" style="--b-hue:95;  --b-h:100px; --b-w:36px; --b-delay:120ms;"></div>
        <div class="deco-book" style="--b-hue:15;  --b-h:148px; --b-w:30px; --b-delay:200ms;"></div>
        <div class="deco-book" style="--b-hue:200; --b-h:86px;  --b-w:38px; --b-delay:280ms;"></div>
        <div class="deco-book" style="--b-hue:350; --b-h:118px; --b-w:34px; --b-delay:360ms;"></div>
      </div>

    </main>
  </body>
</html>
