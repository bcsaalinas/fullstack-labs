<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BookTracker — Your Reading Life</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Lora:ital,wght@0,400;0,500;1,400&family=DM+Sans:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles.css" />
  </head>

  <body>
    <div class="page-noise"></div>

    <nav class="site-nav">
      <div class="nav-inner">
        <a href="/" class="site-logo">
          <span class="logo-icon">&#9753;</span>
          <span class="logo-text">BookTracker</span>
        </a>

        <div class="nav-stats">
          <div class="stat-pill">
            <span class="stat-number"><%= locals.books ? books.length : 0 %></span>
            <span class="stat-label">books read</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-pill">
            <span class="stat-number"><%= locals.books ? books.filter(b => b.notes && b.notes.trim()).length : 0 %></span>
            <span class="stat-label">with notes</span>
          </div>
        </div>

        <div class="nav-auth">
          <% if (locals.user) { %>
            <button class="btn-add-book" id="openAddBook">
              <span class="btn-plus">+</span>
              <span>Add Book</span>
            </button>
            <div class="nav-user" data-profile-menu>
              <button
                type="button"
                class="nav-user-trigger"
                data-profile-trigger
                aria-haspopup="menu"
                aria-expanded="false"
                aria-label="Open profile menu"
              >
                <% if (locals.user.photo) { %>
                  <img class="nav-avatar" src="<%= user.photo %>" alt="<%= user.displayName %>" referrerpolicy="no-referrer" />
                <% } else { %>
                  <div class="nav-avatar nav-avatar-initials"><%= user.displayName ? user.displayName[0].toUpperCase() : '?' %></div>
                <% } %>
                <span class="nav-user-chevron" aria-hidden="true">&#9662;</span>
              </button>
              <div class="nav-user-dropdown" data-profile-dropdown>
                <p class="nav-user-name"><%= user.displayName %></p>
                <p class="nav-user-email"><%= user.email || '' %></p>
                <div class="nav-user-divider"></div>
                <a href="/auth/logout" class="nav-signout" data-profile-item tabindex="-1">Sign out</a>
              </div>
            </div>
          <% } else { %>
            <a href="/auth/google" class="btn-google-signin">
              <svg class="google-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
              </svg>
              <span>Sign in with Google</span>
            </a>
          <% } %>
        </div>
      </div>
    </nav>

    <main class="main-content">
