<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog App</title>
    <link rel="stylesheet" href="styles.css">
  
</head>
<body>
    <main>
    <%- include('../partials/header') %>
    
     <div class="container">
    <div class="card">
      <h1 class="card-title">Create awesome Blog Posts!</h1>
      <p class="card-text">
        Here you can view, post or delete your posts!
      </p>
      <p class="card-text">
        PD: There is no DB implemented yet, so if you refresh the server, your posts will be deleted!
      </p>

      <div class="card-actions">
        <a href="/create"><button class="create-btn btn" type="submit" > Create New Post</button></a>
      </div>
    </div>
  </div>
  <h1 class="posts-title">Recent Posts</h1>
        <% if (posts.length === 0) { %>
        <div class="posts-container-empty"></div>
        <div class="empty-state">
        <p>No posts yet!</p> 
        </div>
    
        <% } else {%>
        <div class="posts-container"></div>
        <% posts.forEach(post => { %>
        <div class="post-card">
        <div class="post-header">
        <h2 class="post-title"> <%= post.title %></h2>
        </div>
        <div class="delete-button"><a href="/delete/<%= post.id %>" class="delete-link"><button class="delete-btn">Delete</button></a></div>
        <div class="post-body">
        <p class="post-text"><%= post.text.substring(0, 150) %>...</p>
        <div class="post-meta">
        <p class="date"><%= post.date %></p>
        <p class="auhtor"> By <strong><%= post.author %></strong></p>
        </div>
        <div class="view-post">
             <a href="/post/<%= post.id %>"> <button class="view-btn">View</button></a>
        </div>
    </div>
        </div>
        <% }) %>
      
        <%}%>
    </div>
  </div>
  </main>
    <%- include('../partials/footer') %>
</body>
</html>