<!DOCTYPE html>
<html lang="en">
    <link rel="stylesheet" href="create.css">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Post</title>
</head>
<body>
    <div class="container">
        <div class="form-card">
        <h1>Create New Post</h1>

        <form action="/submit" method="post">
            <input type="text" name="name" id="author" placeholder="Author">
            
           <textarea name="post-text" id="post-text" placeholder="Write your ideas here"></textarea>
            
            <button type="submit">Submit</button>
        </form>
        </div>
    </div>
</body>
</html>