<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Travis Scott Daily Lyrics</title>
    <style>
      :root {
        --ink: #0f0b07;
        --sand: #c8a676;
        --rust: #c0642f;
        --cactus: #2b3a2c;
        --flare: #f2b34f;
        --ash: #2a1f15;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        font-family: "Impact", "Haettenschweiler", "Franklin Gothic Heavy",
          "Nimbus Sans Narrow", sans-serif;
        color: #f7efe5;
        background: radial-gradient(1200px 600px at 10% 10%, #2b3a2c 0%, transparent 60%),
          radial-gradient(900px 600px at 90% 20%, #6b3f1e 0%, transparent 55%),
          linear-gradient(135deg, #0e0b08 0%, #1c1310 45%, #2a1f15 100%);
        display: grid;
        place-items: center;
        padding: 48px 20px;
      }
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        background-image: linear-gradient(
            0deg,
            rgba(255, 255, 255, 0.05) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(255, 255, 255, 0.03) 1px,
            transparent 1px
          );
        background-size: 24px 24px;
        mix-blend-mode: soft-light;
        opacity: 0.35;
      }
      .stage {
        width: min(760px, 92vw);
        background: linear-gradient(160deg, rgba(43, 58, 44, 0.9), rgba(14, 11, 8, 0.95));
        border: 2px solid rgba(200, 166, 118, 0.4);
        border-radius: 18px;
        padding: 36px 32px;
        box-shadow: 0 30px 60px rgba(0, 0, 0, 0.45);
        position: relative;
        overflow: hidden;
        animation: rise 0.8s ease-out both;
      }
      .stage::after {
        content: "";
        position: absolute;
        inset: -40% -20% auto -20%;
        height: 55%;
        background: radial-gradient(closest-side, rgba(242, 179, 79, 0.25), transparent);
        opacity: 0.7;
      }
      .title {
        font-family: "Trebuchet MS", "Lucida Sans", "Lucida Sans Unicode",
          "Lucida Grande", sans-serif;
        font-size: clamp(2rem, 4vw, 3rem);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin: 0 0 8px;
        color: var(--sand);
        text-shadow: 0 0 20px rgba(200, 166, 118, 0.35);
      }
      .day {
        font-family: "Trebuchet MS", "Lucida Sans", "Lucida Sans Unicode",
          "Lucida Grande", sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        font-size: clamp(0.9rem, 2.5vw, 1.1rem);
        color: var(--flare);
        margin: 0 0 18px;
        animation: glow 1.2s ease-out both;
        animation-delay: 0.1s;
      }
      .divider {
        height: 4px;
        width: 120px;
        background: linear-gradient(90deg, var(--rust), transparent);
        border: 0;
        margin: 0 0 24px;
      }
      .lyric {
        margin: 0;
        font-family: "Georgia", "Times New Roman", serif;
        font-size: clamp(1.1rem, 2.6vw, 1.5rem);
        line-height: 1.6;
        color: #f3e6d3;
        animation: rise 0.9s ease-out both;
        animation-delay: 0.2s;
      }
      .stamp {
        margin-top: 28px;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 8px 14px;
        border: 1px solid rgba(242, 179, 79, 0.4);
        border-radius: 999px;
        font-size: 0.75rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--flare);
        background: rgba(15, 11, 7, 0.55);
      }
      .stamp::before {
        content: "";
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--flare);
        box-shadow: 0 0 10px rgba(242, 179, 79, 0.6);
      }
      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(18px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      @keyframes glow {
        from {
          opacity: 0;
          letter-spacing: 0.4em;
        }
        to {
          opacity: 1;
          letter-spacing: 0.2em;
        }
      }
      @media (max-width: 520px) {
        .stage {
          padding: 28px 22px;
        }
        .title {
          letter-spacing: 0.05em;
        }
      }
    </style>
  </head>
  <body>
    <main class="stage">
      <h1 class="title">Travis Scott Daily Lyrics</h1>
      <h2 class="day"><%= dayName %></h2>
      <hr class="divider" />
      <h3 class="lyric"><%= advice %></h3>
      <div class="stamp">Cactus Jack Daily</div>
    </main>
  </body>
</html>
