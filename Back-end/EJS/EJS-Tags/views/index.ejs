<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>EJS Tags</title>
  </head>

  <body>
    <h1><%=title %></h1>
    <p>Current second: <%= seconds %></p>
    <% if (seconds %2 === 0) { %> <% items.forEach(fruit => { %>
    <ul>
      <%= fruit %>
    </ul>
    <% }) %> <% } else { %>

    <p>no items to display</p>
    <% } %>

    <p><%- htmlContent %></p>

    <%- include('footer.ejs') %>
  </body>
</html>
